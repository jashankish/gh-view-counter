{
  "name": "gh-view-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-cost GitHub profile view counter on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gh-view-counter",
    "db:migrate:local": "wrangler d1 migrations apply gh-view-counter --local",
    "db:migrate": "wrangler d1 migrations apply gh-view-counter --remote",
    "test": "node --no-warnings --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
